{
  "name": "gocube",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:engine2": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint src e2e playwright.config.ts vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:engine2": "tsc -p tsconfig.engine2.json --pretty false",
    "test:coverage": "vitest run --coverage",
    "benchmark:engine2:two-lib": "ENGINE2_BENCHMARK=1 vitest run src/core/endgame/TwoLibertyTacticalReader.benchmark.test.ts --coverage.enabled=false --reporter=verbose",
    "benchmark:engine2:generic": "ENGINE2_GENERIC_BENCHMARK=1 vitest run src/core/endgame/EndgameProofSearchGoAdapter.benchmark.test.ts --coverage.enabled=false --reporter=verbose",
    "benchmark:engine2:three-lib": "ENGINE2_THREE_LIBERTY_BENCHMARK=1 vitest run src/core/endgame/ThreeLibertyProofSearchGoAdapter.benchmark.test.ts --coverage.enabled=false --reporter=verbose",
    "benchmark:engine2:four-lib": "ENGINE2_FOUR_LIBERTY_BENCHMARK=1 vitest run src/core/endgame/FourLibertyProofSearchGoAdapter.benchmark.test.ts --coverage.enabled=false --reporter=verbose",
    "lab:local-ai": "node tools/local-ai/bridge.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.79.0"
  }
}
